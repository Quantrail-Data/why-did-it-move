# ClickHouse (central data store)
CLICKHOUSE_DB=default
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=12345678
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# Least-privilege read-only user used by the backend's analytical queries
CLICKHOUSE_READONLY_USER=ro
CLICKHOUSE_READONLY_PASSWORD=12345678


# PostgreSQL (Langfuse metadata store)
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=12345678
POSTGRES_DB=postgres
POSTGRES_PORT=5432
LANGFUSE_POSTGRES_DB=langfuse


# Redis (Langfuse queue/cache)
REDIS_PASSWORD=123345678
REDIS_PORT=6379


# MinIO (S3-compatible blob storage for Langfuse events/media)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=+0WnVqgmvQMRu4ps
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_LANGFUSE_BUCKET=langfuse


# Langfuse v3 (LLM/agent observability & tracing — the OSS integration for this build)
LANGFUSE_WEB_PORT=3000
LANGFUSE_WORKER_PORT=3030
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=2+Zl8CU32YrJmxxmYM5w0/vP4qt/R1cQURfkwJT8zv4=
LANGFUSE_SALT=2+Zl8CU32YrJmxxmYM5w0/vP4qt/R1cQURfkwJT8zv4=
LANGFUSE_ENCRYPTION_KEY=bb27ad0259639aa43a907c4ecfab52360c731b5a5d382493ad7592c2f0f05147
LANGFUSE_INIT_ORG_ID=why-did-it-move
LANGFUSE_INIT_ORG_NAME=CH-Minds
LANGFUSE_INIT_PROJECT_ID=inmobi-rca
LANGFUSE_INIT_PROJECT_NAME="Why Did It Move"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-f8f40427-44a7-4bef-b218-794fbdaf06ba
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-72a750cb-859c-40b1-b57d-14f2dc5e16b8
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=12345678
LANGFUSE_INIT_USER_NAME=Admin


# LLM provider — ACTIVE_LLM_PROVIDER selects which key the backend's LLM
# client uses for narration + the /api/ask chat endpoint. Swap providers by
# changing this one var and restarting the backend container; no code change.
ACTIVE_LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGEME_openai_api_key
ANTHROPIC_API_KEY=CHANGEME_anthropic_api_key
GEMINI_API_KEY=CHANGEME_gemini_api_key
# Optional: override the default model per provider without touching code
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.0-flash


# Backend (FastAPI — detect/drill-down/narrate pipeline + API)
BACKEND_PORT=8001

# Frontend (Vite + React + Tailwind + shadcn/ui dashboard)
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://localhost:8001


# Which optional Compose profile(s) to bring up by default.
# Only Langfuse is used in this build — see INMOBI_CONTEXT.md for why
# ClickStack and LibreChat were evaluated and excluded (FORCED, not NATURAL,
# for this specific problem statement).
COMPOSE_PROFILES=langfuse
